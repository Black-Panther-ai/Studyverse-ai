rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(sellerUid) {
      return isAuthenticated() && request.auth.uid == sellerUid;
    }

    // Public Listing Images: Publicly readable, writeable only by listing owner
    match /listing-images/{sellerUid}/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(sellerUid)
        && request.resource.size < 10 * 1024 * 1024 // 10MB limit
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(sellerUid);
    }

    // Private Digital Files: Private read/write restricted to seller owner
    match /digital-files/{sellerUid}/{listingId}/{fileName} {
      allow read: if isOwner(sellerUid);
      allow write: if isOwner(sellerUid)
        && request.resource.size < 50 * 1024 * 1024 // 50MB limit
        && request.resource.contentType == 'application/pdf';
      allow delete: if isOwner(sellerUid);
    }

    // Unknown storage paths denied by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
